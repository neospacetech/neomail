{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neosuite:neomail:event:neomail.message.marked",
  "title": "Message marked",
  "description": "CloudEvents 1.0 `data` for the neomail.message.marked event. A message was marked seen, unseen, flagged or unflagged. Thin payload: consumers fetch the object through the Object Service with their own principal.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ref",
    "changed",
    "version",
    "seen",
    "flagged"
  ],
  "properties": {
    "ref": {
      "description": "Object URI of the message.",
      "type": "string",
      "pattern": "^neo://[^/]+/o/[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "changed": {
      "description": "Names of the fields set by this change.",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "seen",
          "flagged"
        ]
      },
      "uniqueItems": true
    },
    "version": {
      "description": "Object version after the change.",
      "type": "integer",
      "minimum": 1
    },
    "seen": {
      "description": "Non-sensitive scalar.",
      "type": "boolean"
    },
    "flagged": {
      "description": "Non-sensitive scalar.",
      "type": "boolean"
    }
  },
  "x-neosuite": {
    "event": "neomail.message.marked",
    "object_type": "neomail.Message",
    "envelope": {
      "specversion": "1.0",
      "type": "neomail.message.marked",
      "source": "neo://{tenant}/neomail",
      "subject": "{object ulid}",
      "datacontenttype": "application/json"
    }
  }
}
