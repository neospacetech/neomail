{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neosuite:neomail:event:neomail.item.created",
  "title": "Item created",
  "description": "CloudEvents 1.0 `data` for the neomail.item.created event. Thin payload: consumers fetch the object through the Object Service with their own principal.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ref", "changed", "version"],
  "properties": {
    "ref": {
      "description": "Object URI of the created item.",
      "type": "string",
      "pattern": "^neo://[^/]+/o/[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "changed": {
      "description": "Names of the fields set by this change.",
      "type": "array",
      "items": { "type": "string", "enum": ["title", "slug", "status"] },
      "uniqueItems": true
    },
    "version": {
      "description": "Object version after the change.",
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "description": "Non-sensitive scalar: the item's status after the change.",
      "type": "string",
      "enum": ["todo", "doing", "done"]
    }
  },
  "x-neosuite": {
    "event": "neomail.item.created",
    "object_type": "neomail.Item",
    "envelope": {
      "specversion": "1.0",
      "type": "neomail.item.created",
      "source": "neo://{tenant}/neomail",
      "subject": "{object ulid}",
      "datacontenttype": "application/json"
    }
  }
}
